#include<stdio.h>
int Add(int a,int b){
    return a+b;
}
int main(){
    int a=1;
    int b=1;
    int n=2;
    int k;
    printf("Please input k:");
    scanf("%d",&k);
    if(k==1 || k==2){
        printf("1");
        return 0;
    }
    for(int i=3;i<=k;i++){
        n=Add(a,b);
        a=b;
        b=n;
        
    }
    printf("%d",n);
    return 0;
}
